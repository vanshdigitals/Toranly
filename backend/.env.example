# Toranly backend configuration. Copy to backend/.env and fill in.
# Server-side only: none of these values may ever reach the browser or the web build.
# backend/.env is git-ignored. Never commit real values. "your_..._here" counts as not set.

APP_ENV=development                # development | test | production
DATABASE_URL=postgresql+psycopg://toranly:toranly@localhost:5432/toranly
SESSION_SECRET=                    # 64+ random bytes; signs the device cookie (required in production)
IP_HASH_SALT=                      # random; IPs are hashed with it before storing (required in production)

# Primary AI provider: xAI / Grok. Keys from console.x.ai start with "xai-".
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3                 # docs.x.ai model id; structured outputs via the Responses API
XAI_API_STYLE=responses            # responses (default) | chat (fallback adapter)
XAI_ACCOUNT_RPM=                   # console.x.ai > Models: RPS x 48 (60 if RPS shows 2)
XAI_ACCOUNT_TPM=                   # console.x.ai > Models: TPM
XAI_PRICE_INPUT_PER_M=1.25         # USD per 1M input tokens (grok-4.3); verify before release
XAI_PRICE_OUTPUT_PER_M=2.50        # USD per 1M output tokens (grok-4.3); verify before release

# Fallback AI provider: Groq. Keys from console.groq.com start with "gsk_".
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b     # needs strict json_schema support: openai/gpt-oss-120b or openai/gpt-oss-20b
GROQ_ACCOUNT_RPM=                  # console.groq.com > Settings > Limits, for GROQ_MODEL
GROQ_ACCOUNT_TPM=                  # same page; empty = 10 RPM / 8000 TPM in development, Groq off in production
GROQ_PRICE_INPUT_PER_M=0.15        # USD per 1M input tokens (gpt-oss-120b); verify before release
GROQ_PRICE_OUTPUT_PER_M=0.60       # USD per 1M output tokens (gpt-oss-120b); verify before release

# Provider selection and failover
AI_PRIMARY_PROVIDER=xai            # xai | groq
AI_FALLBACK_PROVIDER=groq          # xai | groq | none
AI_FAILOVER_ENABLED=true
XAI_SAFETY_FACTOR=0.8              # share of each provider's account RPM/TPM the app may use (both providers)

# Timeouts and retries (per logical request)
AI_REQUEST_TIMEOUT_SECONDS=30      # per provider call (old name XAI_TIMEOUT_SECONDS still works)
AI_MAX_RETRIES_PER_PROVIDER=1      # 0-2; covers transient, rate-limit and JSON-repair retries
AI_FAILOVER_COOLDOWN_SECONDS=60    # skip a provider this long after billing errors or an outage

# Usage limits (server-side, shared across workers in Postgres; counted once per user request,
# however many providers are tried; not equal to provider billing units or tokens)
AI_LIMIT_PER_DEVICE_PER_MINUTE=2
AI_LIMIT_PER_DEVICE_PER_DAY=5
AI_LIMIT_PER_IP_PER_DAY=20
AI_GLOBAL_DAILY_LIMIT=100
AI_DAILY_SPEND_LIMIT_USD=2.00      # estimated USD per UTC day across both providers
AI_MAX_OUTPUT_TOKENS=2500          # answer budget; Groq gets 1024 more for reasoning
AI_MAX_CONCURRENT=3

API_LIMIT_PER_IP_PER_MINUTE=60
CORS_ORIGINS=http://localhost:5173 # development only; empty in production (same origin)
MAX_BODY_BYTES=65536

# Deployment
APP_ORIGIN=                        # production: exact public origin, e.g. https://toranly.onrender.com
TRUSTED_PROXY_CIDRS=               # production on Render: verify the proxy range (see README)
WEB_CONCURRENCY=1                  # Uvicorn workers; each provider guard divides its budget by it
