{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:types": "openapi-typescript openapi.json -o src/api/schema.ts",
    "api:types:check": "openapi-typescript openapi.json -o src/api/schema.ts --check",
    "e2e": "npm run build && playwright test",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary --coverage.include=src/domain/** --coverage.include=src/storage/** --coverage.include=src/api/** --coverage.include=src/lib/** --coverage.exclude=src/api/schema.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.62.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^5.0.5"
  }
}
